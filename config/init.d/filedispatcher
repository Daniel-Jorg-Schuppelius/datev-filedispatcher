#!/bin/sh
### BEGIN INIT INFO
# Provides:          filedispatcher
# Required-Start:    $remote_fs $network
# Required-Stop:     $remote_fs $network
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: Start the internal dispatcher Script
# Description:       Internal Dispatcher observes a directory tree for files that can be moved into
#                    internal area
### END INIT INFO

# Authors: Daniel Jörg Schuppelius <daniel.schuppelius@gmail.com>
#          Georg Klimm <gklimm@gmail.com>
#
# Für systemd-Systeme wird config/systemd/filedispatcher.service empfohlen.

PATH=/sbin:/usr/sbin:/bin:/usr/bin
DESC="Internal Dispatcher"
NAME="filedispatcher.sh"

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
PROJECT_ROOT="$SCRIPT_DIR/../.."
SCRIPT="$PROJECT_ROOT/scripts/$NAME"

DAEMON="$SCRIPT"
DAEMON_ARGS=""
PIDFILE="/var/run/$NAME.pid"
SCRIPTNAME="/etc/init.d/filedispatcher"

# Der Dienst läuft nicht als root: Er verarbeitet Dateien aus dem Eingang mit externen Programmen.
DAEMON_USER="filedispatcher"
DAEMON_GROUP=""
FILEDISPATCHER_LOCKDIR="/run/filedispatcher"
FILEDISPATCHER_LOGDIR="/var/log/filedispatcher"
FILEDISPATCHER_UMASK="0027"

# Exit if the package is not installed
[ -x "$DAEMON" ] || exit 0

# Konfiguration lesen und an den Dienst weitergeben (früherer Name: /etc/default/filedispatcher.sh)
set -a
[ -r /etc/default/$NAME ] && . /etc/default/$NAME
[ -r /etc/default/filedispatcher ] && . /etc/default/filedispatcher
set +a

# Load the VERBOSE setting and other rcS variables
. /lib/init/vars.sh

# Define LSB log_* functions.
# Depend on lsb-base (>= 3.0-6) to ensure that this file is present.
. /lib/lsb/init-functions

# Funktion, die den Daemon/Dienst startet
do_start() {
    # Return:
    #   0, wenn der Daemon gestartet wurde
    #   1, wenn der Daemon bereits läuft
    #   2, wenn der Daemon nicht gestartet werden konnte
    if ! id "$DAEMON_USER" > /dev/null 2>&1; then
        log_failure_msg "Benutzer $DAEMON_USER existiert nicht. Anlegen mit 'useradd --system --no-create-home --shell /usr/sbin/nologin $DAEMON_USER' oder DAEMON_USER in /etc/default/filedispatcher setzen."
        return 2
    fi

    # Lock-Verzeichnis nur für den Dienstbenutzer, Logverzeichnis (Logging.path) zusätzlich für dessen Gruppe lesbar
    install -d -m 0700 -o "$DAEMON_USER" "$FILEDISPATCHER_LOCKDIR" || return 2
    install -d -m 0750 -o "$DAEMON_USER" "$FILEDISPATCHER_LOGDIR" || return 2

    start-stop-daemon --start --quiet --pidfile $PIDFILE --startas $DAEMON --test > /dev/null || return 1
    start-stop-daemon --start --quiet --background --make-pidfile --pidfile $PIDFILE \
        --chuid "$DAEMON_USER${DAEMON_GROUP:+:$DAEMON_GROUP}" --umask "$FILEDISPATCHER_UMASK" \
        --startas $DAEMON -- $DAEMON_ARGS || return 2
}

# Funktion, die den Daemon/Dienst stoppt
do_stop() {
    # Return:
    #   0, wenn der Daemon gestoppt wurde
    #   1, wenn der Daemon bereits gestoppt war
    #   2, wenn der Daemon nicht gestoppt werden konnte
    # Das Skript beendet bei TERM seine Kindprozesse (inotifywait, Rescan, laufende Verarbeitungen).
    start-stop-daemon --stop --quiet --retry=TERM/30/KILL/5 --pidfile $PIDFILE --remove-pidfile
    return "$?"
}

# Hauptsteuerung des Dienstes
case "$1" in
  start)
    [ "$VERBOSE" != no ] && log_daemon_msg "Starting $DESC" "$NAME"
    do_start
    case "$?" in
        0|1) [ "$VERBOSE" != no ] && log_end_msg 0 ;;
        2) [ "$VERBOSE" != no ] && log_end_msg 1 ;;
    esac
    ;;
  stop)
    [ "$VERBOSE" != no ] && log_daemon_msg "Stopping $DESC" "$NAME"
    do_stop
    case "$?" in
        0|1) [ "$VERBOSE" != no ] && log_end_msg 0 ;;
        2) [ "$VERBOSE" != no ] && log_end_msg 1 ;;
    esac
    ;;
  restart|force-reload)
    log_daemon_msg "Restarting $DESC" "$NAME"
    do_stop
    case "$?" in
      0|1)
        do_start
        case "$?" in
            0) log_end_msg 0 ;;
            1) log_end_msg 1 ;; # Der alte Prozess läuft noch
            *) log_end_msg 1 ;; # Start fehlgeschlagen
        esac
        ;;
      *)
        log_end_msg 1 ;; # Stopp fehlgeschlagen
    esac
    ;;
  *)
    echo "Usage: $SCRIPTNAME {start|stop|restart|force-reload}" >&2
    exit 3
    ;;
esac

exit 0
