{
  "name": "daniel-jorg-schuppelius/datev-filedispatcher",
  "description": "Sortiert Dokumente aus dem DATEV DMS und der Lohnabrechnung automatisch in die Mandantenverzeichnisse.",
  "type": "project",
  "license": "MIT",
  "authors": [
    {
      "name": "Daniel Joerg Schuppelius",
      "email": "info@schuppelius.org"
    }
  ],
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "prefer-stable": true,
  "require": {
    "php": ">=8.2 <8.5",
    "daniel-jorg-schuppelius/datev-php-sdk": "^1.0"
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^11.3@dev",
    "phpstan/phpstan": "^2.1",
    "laravel/pint": "^1.27"
  },
  "scripts": {
    "test": "vendor/bin/phpunit",
    "format": "vendor/bin/pint --test",
    "format:fix": "vendor/bin/pint",
    "lint": "vendor/bin/phpstan analyse --memory-limit=1G",
    "qa": [
      "@format",
      "@lint",
      "@test"
    ]
  },
  "config": {
    "platform": {
      "php": "8.2.0"
    }
  }
}
